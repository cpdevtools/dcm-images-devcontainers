{
  "name": "Dev Container",
  "remoteUser": "node",
  "workspaceFolder": "/devcontainer/workspaces",
  "build": {
    "dockerfile": "dockerfile",
    "context": ".",
    "args": {
      "IMAGE_VERSION": "20-bullseye"
    }
  },
  "containerEnv": {
    "CONTAINER_FOLDER": "/devcontainer",
    "CONTAINER_SETTINGS_FOLDER": "/devcontainer/.devcontainer",
    "REPOS": "/devcontainer/repos",
    "CONTAINER_DATA_FOLDER": "/devcontainer/.devcontainer/.data",
    "CLAUDE_CONFIG_DIR": "/devcontainer/.devcontainer/.data/claude-config",
    "PNPM_HOME": "/devcontainer/.devcontainer/.data/pnpm",
    "YARN_CACHE_FOLDER": "/devcontainer/.devcontainer/.data/yarn",
    "pnpm_config_store_dir": "/devcontainer/.devcontainer/.data/pnpm/store",
    "pnpm_config_verify_deps_before_run": "false"
  },
  "onCreateCommand": "/usr/local/bin/dc-init-data.sh && cd $CONTAINER_FOLDER && dcm dc-event onCreate ${devcontainerId} && cd $CONTAINER_SETTINGS_FOLDER && pnpm run --if-present dc-onCreateCommand",
  "updateContentCommand": "cd $CONTAINER_FOLDER && dcm dc-event updateContent ${devcontainerId} && cd $CONTAINER_SETTINGS_FOLDER && pnpm run --if-present dc-updateContentCommand",
  "postCreateCommand": "cd $CONTAINER_FOLDER && dcm dc-event postCreate ${devcontainerId} && cd $CONTAINER_SETTINGS_FOLDER && pnpm run --if-present dc-postCreateCommand",
  "postAttachCommand": "cd $CONTAINER_FOLDER && dcm dc-event postAttach ${devcontainerId} && cd $CONTAINER_SETTINGS_FOLDER && pnpm run --if-present dc-postAttachCommand",
  "postStartCommand": "/usr/local/bin/dc-init-data.sh && cd $CONTAINER_FOLDER && dcm dc-event postStart ${devcontainerId} && cd $CONTAINER_SETTINGS_FOLDER && pnpm run --if-present dc-postStartCommand",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21"
    },
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/devcontainers-extra/features/tsx:1": {},
    "ghcr.io/devcontainers-extra/features/npm-package:1": {
      "package": "@cpdevtools/dcman-cli"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "git.defaultCloneDirectory": "/devcontainer/repos",
        "git.pullTags": false,
        "git.autofetch": "all",
        "terminal.integrated.scrollback": 10000,
        "cSpell.words": [
          "entrypoints",
          "loadbalancer",
          "middlewares",
          "stripprefix",
          "traefik",
          "letsencrypt",
          "pnpm",
          "devcontainer"
        ]
      },
      "extensions": [
        "42Crunch.vscode-openapi",
        "christian-kohler.npm-intellisense",
        "christian-kohler.path-intellisense",
        "Anthropic.claude-code",
        "dbaeumer.vscode-eslint",
        "donjayamanne.githistory",
        "EditorConfig.EditorConfig",
        "esbenp.prettier-vscode",
        "formulahendry.auto-rename-tag",
        "GitHub.copilot",
        "GitHub.vscode-github-actions",
        "GitHub.vscode-pull-request-github",
        "heaths.vscode-guid",
        "hediet.vscode-drawio",
        "johnpapa.vscode-peacock",
        "mikestead.dotenv",
        "ms-azuretools.vscode-docker",
        "ms-vscode-remote.remote-containers",
        "redhat.vscode-xml",
        "redhat.vscode-yaml",
        "streetsidesoftware.code-spell-checker",
        "yoavbls.pretty-ts-errors"
      ]
    }
  }
}
