{
  "name": "Dev Container",
  "remoteUser": "node",
  "workspaceFolder": "/devcontainer/workspaces",
  "build": {
    "dockerfile": "dockerfile",
    "context": ".",
    "args": {
      "VERSION": "${localEnv:PROJECT_VERSION:latest}"
    }
  },
  "containerEnv": {
    "NUGET_PACKAGES": "/devcontainer/.devcontainer/.data/nuget/packages",
    "NUGET_HTTP_CACHE_PATH": "/devcontainer/.devcontainer/.data/nuget/http-cache",
    "NUGET_PLUGINS_CACHE_PATH": "/devcontainer/.devcontainer/.data/nuget/plugins-cache"
  },
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "11.0-preview",
      "additionalVersions": "10.0,9.0,8.0,6.0"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "cSpell.words": ["linq", "nuget"]
      },
      "extensions": ["ms-dotnettools.csdevkit"]
    }
  }
}
